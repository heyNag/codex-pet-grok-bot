{
  "name": "codex-pet-grok-bot",
  "version": "1.3.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "description": "A full-range Grok Bot pet for Codex desktop.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pets": "node scripts/build.mjs --sprites-only",
    "build:source-motion": "node scripts/build-source-motion.mjs",
    "build:showcase": "node scripts/build-readme-showcase.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:dark": "node scripts/validate.mjs dark",
    "validate:light": "node scripts/validate.mjs light",
    "qa:themes": "node scripts/compare-themes.mjs",
    "qa:edges": "node scripts/alpha-edge-qa.mjs",
    "qa:animated": "node scripts/animated-atlas-qa.mjs",
    "qa:animated:check": "node scripts/animated-atlas-qa.mjs --check",
    "qa:phases": "node scripts/arbitrary-phase-qa.mjs",
    "qa:phases:check": "node scripts/arbitrary-phase-qa.mjs --check",
    "qa:exhaustive": "node scripts/exhaustive-edge-qa.mjs",
    "qa:exhaustive:check": "node scripts/exhaustive-edge-qa.mjs --check",
    "qa:source-motion": "node scripts/source-motion-qa.mjs",
    "qa:runtime": "node scripts/runtime-continuity.mjs",
    "qa:official": "node scripts/verify-official-hatch-qa.mjs",
    "qa:blind": "node scripts/seal-direction-blind.mjs",
    "qa:blind:check": "node scripts/seal-direction-blind.mjs --check",
    "qa:review": "node scripts/seal-final-visual-review.mjs",
    "qa:review:check": "node scripts/seal-final-visual-review.mjs --check",
    "test": "node --test",
    "qa:evidence": "node scripts/qa-evidence.mjs",
    "qa:prepare": "npm run build && npm run validate && npm run qa:animated && npm run qa:animated:check && npm run qa:phases:check && npm run qa:exhaustive && npm run qa:exhaustive:check && npm run qa:themes && npm run qa:edges && npm run qa:runtime && npm run qa:source-motion && npm run qa:blind:check && npm run qa:official && npm test",
    "qa:seal": "npm run qa:prepare && npm run qa:review:check && node scripts/qa-evidence.mjs --seal",
    "qa": "npm run qa:prepare && npm run qa:review:check && npm run qa:evidence",
    "preview": "node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "sharp": "0.35.4"
  }
}
